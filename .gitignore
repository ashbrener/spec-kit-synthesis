.env
.env.*
*.log
.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/

# per-run build artifacts (stateless; regenerated each run — DESIGN §11.2 #4)
# .atlas/ is the default work dir; .atlas-<name>/ are scratch dogfood dirs
.atlas*/

# Spec-kit self-host (sibling convention): COMMIT the scaffold
# (.specify/scripts, /templates, /memory/constitution.md) — ignore only runtime + per-checkout state.
.specify/cache/
.specify/feature.json

# Claude Code local-only (tracked: .claude/skills, .claude/commands; ignored: machine state)
.claude/settings.local.json
.claude/worktrees/
.mcp.json
